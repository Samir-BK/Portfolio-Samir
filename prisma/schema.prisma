generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentStage {
  DRAFT
  PUBLISHED
}

enum ProjectVisual {
  queue
  trace
  notes
}

model Project {
  id        Int              @id @default(autoincrement())
  slug      String           @unique
  isDemo    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?
  versions  ProjectVersion[]
}

model ProjectVersion {
  id            Int                 @id @default(autoincrement())
  projectId     Int
  stage         ContentStage
  version       Int                 @default(1)
  title         String
  summary       String
  overview      String
  problem       String
  approach      String
  decisions     String
  challenges    String
  lessons       String
  visual        ProjectVisual
  featured      Boolean             @default(false)
  featuredOrder Int                 @default(0)
  repositoryUrl String?
  demoUrl       String?
  publishedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category      ProjectCategory?
  technologies  ProjectTechnology[]
  media         ProjectMedia[]

  @@unique([projectId, stage])
  @@index([stage, featuredOrder, projectId])
}

model ProjectCategory {
  projectVersionId Int            @id
  key              String
  label            String
  projectVersion   ProjectVersion @relation(fields: [projectVersionId], references: [id], onDelete: Cascade)

  @@index([key])
}

model ProjectTechnology {
  projectVersionId Int
  key              String
  label            String
  position         Int
  projectVersion   ProjectVersion @relation(fields: [projectVersionId], references: [id], onDelete: Cascade)

  @@id([projectVersionId, key])
  @@index([key])
}

model ProjectMedia {
  projectVersionId Int
  position         Int
  src              String
  alt              String
  width            Int
  height           Int
  projectVersion   ProjectVersion @relation(fields: [projectVersionId], references: [id], onDelete: Cascade)

  @@id([projectVersionId, position])
}

model Post {
  id        Int           @id @default(autoincrement())
  slug      String        @unique
  isDemo    Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  versions  PostVersion[]
}

model PostVersion {
  id          Int          @id @default(autoincrement())
  postId      Int
  stage       ContentStage
  version     Int          @default(1)
  title       String
  summary     String
  markdown    String
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  post        Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  tags        PostTag[]

  @@unique([postId, stage])
  @@index([stage, publishedAt, postId])
}

model PostTag {
  postVersionId Int
  key           String
  label         String
  position      Int
  postVersion   PostVersion @relation(fields: [postVersionId], references: [id], onDelete: Cascade)

  @@id([postVersionId, key])
  @@index([key])
}

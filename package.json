{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.21.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.mjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --conditions=react-server prisma/seed.ts",
    "test:db": "node --env-file-if-exists=.env --env-file-if-exists=.env.test --conditions=react-server --test tests/database.integration.mjs",
    "db:personalize": "node --env-file-if-exists=.env.personalization --conditions=react-server prisma/personalize.ts",
    "db:chat-profile": "node --env-file-if-exists=.env --conditions=react-server prisma/chat-profile.ts",
    "test:chat": "node --env-file-if-exists=.env --env-file-if-exists=.env.test --conditions=react-server --test tests/chat.integration.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "groq-sdk": "1.6.0",
    "marked": "18.2.1",
    "motion": "14.14.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.8.3",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}

# Local example: postgresql://portfolio:PASSWORD@127.0.0.1:5432/portfolio_dev
DATABASE_URL=

# Optional direct PostgreSQL URL for the migration role
DATABASE_MIGRATION_URL=

# Public origin, for example https://portfolio.example
SITE_ORIGIN=

# Server-only portfolio assistant settings (disabled by default)
AI_CHAT_ENABLED=false
AI_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
AI_CHAT_PER_MINUTE=8
AI_CHAT_PER_DAY=50
AI_CHAT_PER_MONTH=500
AI_CHAT_CONCURRENT=2
AI_CHAT_TIMEOUT_MS=20000
